# target to build an object file
util.cpp.obj:
	cd /workspaces/numstacoin/build-win && $(MAKE) $(MAKESILENT) -f src/common/CMakeFiles/obj_common.dir/build.make src/common/CMakeFiles/obj_common.dir/util.cpp.obj
.PHONY : util.cpp.obj

util.i: util.cpp.i
.PHONY : util.i

# target to preprocess a source file
util.cpp.i:
	cd /workspaces/numstacoin/build-win && $(MAKE) $(MAKESILENT) -f src/common/CMakeFiles/obj_common.dir/build.make src/common/CMakeFiles/obj_common.dir/util.cpp.i
.PHONY : util.cpp.i

util.s: util.cpp.s
.PHONY : util.s

# target to generate assembly for a file
util.cpp.s:
	cd /workspaces/numstacoin/build-win && $(MAKE) $(MAKESILENT) -f src/common/CMakeFiles/obj_common.dir/build.make src/common/CMakeFiles/obj_common.dir/util.cpp.s
.PHONY : util.cpp.s

