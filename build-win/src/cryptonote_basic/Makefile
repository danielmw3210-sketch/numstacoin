	@echo "... merge_mining.i"
	@echo "... merge_mining.s"
	@echo "... miner.obj"
	@echo "... miner.i"
	@echo "... miner.s"
	@echo "... numista_assets.obj"
	@echo "... numista_assets.i"
	@echo "... numista_assets.s"
.PHONY : help



#=============================================================================
# Special targets to cleanup operation of make.

# Special rule to run CMake to check the build system integrity.
# No rule that depends on this can have commands that come from listfiles
# because they might be regenerated.
cmake_check_build_system:
	cd /workspaces/numstacoin/build-win && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
.PHONY : cmake_check_build_system

